---
import { useLocale } from '../i18n';
import { getProductPages } from '../data/products';
import { cheatTierIcons, productCategoryIcons } from '../data/sectionIcons';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import { productPath } from '../utils/path';
import type { ProductPage } from '../data/products';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const productPages = getProductPages(locale);
const s = t.products;

function cardIcon(product: ProductPage) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

const skinChangerHomeSubtitle =
  'Unlock premium skins and outfits in your own game client; items are not added to your account inventory. Confirm your title is supported first.';

function cardSubtitle(product: ProductPage): string {
  if (product.slug === 'skin-changer') {
    return skinChangerHomeSubtitle;
  }
  if (product.kind === 'utility') {
    return product.subtitle;
  }
  const line = t.cheats.subtitle;
  const short = line.includes('. ') ? line.split('. ')[0].trim() : line;
  return short || product.tier || product.name;
}

function cardBodyDesc(product: ProductPage): string {
  if (product.kind === 'tier') {
    const marker = 'Cloud DMA';
    const idx = product.desc.indexOf(marker);
    if (idx >= 0) return product.desc.slice(idx).trim();
  }
  return product.desc;
}

function cardTags(product: ProductPage): string[] {
  const tags: string[] = [];
  if (product.kind === 'tier' && product.tier) tags.push(product.tier);
  if (product.badge) tags.push(product.badge);
  if (product.kind === 'utility' && product.category) tags.push(product.category);
  return tags;
}
---

<section id="products" class="py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />

    <div
      class="mt-12 grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:grid-rows-[auto_1fr_auto_auto]"
      data-reveal-stagger
    >
      {
        productPages.map((product) => {
          const isSkinChanger = product.slug === 'skin-changer';
          const bullets = isSkinChanger ? product.features : product.features.slice(0, 3);
          const tags = cardTags(product);
          const pageHref = lp(productPath(product.slug));
          return (
            <article
              class="group flex h-full min-h-0 flex-col overflow-hidden rounded-2xl border border-border bg-card text-left shadow-sm transition-colors hover:border-primary/35 lg:row-span-4 lg:grid lg:grid-rows-subgrid"
            >
              <header class="card-title-band shrink-0 px-5 py-5 sm:px-6">
                <div class="flex items-center gap-3">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-primary/10">
                    <Icon name={cardIcon(product)} size={18} />
                  </span>
                  <h3 class="min-w-0 flex-1 font-[family-name:var(--font-heading)] text-base font-bold leading-tight text-foreground md:text-lg">
                    <a href={pageHref} class="hover:text-primary">{product.title}</a>
                  </h3>
                </div>
                <p class="mt-3 w-full min-w-0 text-sm font-medium leading-relaxed text-neutral-600 dark:text-neutral-300">
                  {cardSubtitle(product)}
                </p>
              </header>

              <div class="flex min-h-0 min-w-0 flex-1 flex-col gap-3 px-5 pt-5 pb-5 sm:px-6">
                <p class="text-sm leading-relaxed text-muted-foreground">{cardBodyDesc(product)}</p>

                {
                  bullets.length > 0 && (
                    <ul class="min-h-0 flex-1 space-y-2 text-sm text-muted-foreground">
                      {bullets.map((b) => (
                        <li class="flex items-start gap-2.5">
                          <Icon
                            name="check"
                            size={14}
                            class={isSkinChanger ? 'mt-0.5 shrink-0 text-primary' : 'mt-0.5 shrink-0'}
                          />
                          <span class="leading-snug">{b}</span>
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>

              <div class="flex shrink-0 flex-col justify-end border-t border-border px-5 pt-4 pb-5 sm:px-6">
                <Button as="a" href={pageHref} variant="primary" size="sm" class="w-full rounded-xl">
                  {s.viewDetails}
                  <Icon name="arrowRight" size={17} />
                </Button>
              </div>

              {
                tags.length > 0 && (
                  <div class="card-footer-band shrink-0 flex flex-wrap gap-1.5 px-5 py-4 sm:px-6">
                    {tags.map((tag) => (
                      <Badge variant="secondary" class="text-[11px]">{tag}</Badge>
                    ))}
                  </div>
                )
              }
            </article>
          );
        })
      }
    </div>
  </div>
</section>
