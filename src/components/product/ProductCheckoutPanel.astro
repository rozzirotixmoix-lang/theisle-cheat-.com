---
import type { ProductPage } from '../../data/products';
import { checkoutUrlWithPlan, getProductPlans, type ProductPlanId } from '../../data/productPricing';
import Icon from '../icons/Icon.astro';
import ProductIconWell from './ProductIconWell.astro';
import { Button } from '@/components/starwind/button';
import { useLocale } from '../../i18n';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
const { t } = useLocale(Astro.currentLocale);
const plans = getProductPlans(product.slug);
const planCopy = (id: ProductPlanId) => {
  if (id === 'monthly') return { label: t.products.planMonthly };
  if (id === 'lifetime') return { label: t.products.planLifetime };
  return { label: t.products.planOneTime };
};
const localizedPlans = plans.map((plan) => {
  const copy = planCopy(plan.id);
  return {
    id: plan.id,
    label: copy.label,
    recommended: plan.recommended,
  };
});
const defaultPlan = localizedPlans.find((plan) => plan.recommended) ?? localizedPlans[0]!;
const isSinglePlan = localizedPlans.length === 1;
---

<aside
  class="product-checkout text-left lg:sticky lg:top-24"
  aria-labelledby={`checkout-${product.slug}`}
  data-product-checkout
  data-buy-url={product.buyUrl}
  data-plans={JSON.stringify(localizedPlans)}
>
  <div class="product-checkout__card flex h-full flex-col overflow-hidden rounded-2xl border border-primary/35 bg-card shadow-md ring-1 ring-primary/15">
    <div class="card-title-band flex items-center justify-start gap-3 px-5 py-4 text-left">
      <ProductIconWell name="acqPackage" iconSize={20} class="bg-primary/15" />
      <div class="min-w-0 text-left">
        <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">{t.products.checkoutEyebrow}</p>
        <h2 id={`checkout-${product.slug}`} class="text-base font-semibold leading-snug">
          {isSinglePlan ? t.products.checkoutSingle : t.products.checkoutSelect}
        </h2>
      </div>
    </div>

    <div class="product-checkout__body flex flex-1 flex-col gap-4 px-5 pb-5 pt-5">
      {
        !isSinglePlan && (
          <label class="flex flex-col gap-1.5">
            <span class="text-xs font-medium text-muted-foreground">{t.products.checkoutSelect}</span>
            <select
              class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm font-medium text-foreground"
              data-plan-select
              aria-label={t.products.checkoutSelect}
            >
              {localizedPlans.map((plan) => (
                <option value={plan.id} selected={plan.id === defaultPlan.id}>
                  {plan.label}
                </option>
              ))}
            </select>
          </label>
        )
      }

      <Button
        as="a"
        href={checkoutUrlWithPlan(product.buyUrl, defaultPlan.id)}
        variant="primary"
        size="lg"
        class="w-full rounded-xl"
        data-checkout-buy
      >
        {t.products.buyNow}
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</aside>

<script>
  const initProductCheckoutPanels = () => {
    document.querySelectorAll('[data-product-checkout]').forEach((root) => {
      if (root.hasAttribute('data-checkout-bound')) return;
      root.setAttribute('data-checkout-bound', '');

      const buyUrl = root.getAttribute('data-buy-url');
      if (!buyUrl) return;

      const select = root.querySelector<HTMLSelectElement>('[data-plan-select]');
      const buyBtn = root.querySelector<HTMLAnchorElement>('[data-checkout-buy]');
      if (!buyBtn) return;

      const sync = () => {
        const planId = select?.value;
        if (!planId) return;
        const separator = buyUrl.includes('?') ? '&' : '?';
        buyBtn.href = `${buyUrl}${separator}plan=${planId}`;
      };

      select?.addEventListener('change', sync);
      sync();
    });
  };

  initProductCheckoutPanels();
  document.addEventListener('astro:after-swap', initProductCheckoutPanels);
</script>
