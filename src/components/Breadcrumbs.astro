---
import type { BreadcrumbItem } from '../utils/schema';
import { useLocale } from '../i18n';
import {
  Breadcrumb,
  BreadcrumbItem as CrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/starwind/breadcrumb';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const { lp } = useLocale(Astro.currentLocale);
---

<Breadcrumb class:list={['mb-4', className]}>
  <BreadcrumbList>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <>
          <CrumbItem>
            {isLast ? (
              <BreadcrumbPage>{item.name}</BreadcrumbPage>
            ) : (
              <BreadcrumbLink href={lp(item.path)}>{item.name}</BreadcrumbLink>
            )}
          </CrumbItem>
          {!isLast && <BreadcrumbSeparator />}
        </>
      );
    })}
  </BreadcrumbList>
</Breadcrumb>
