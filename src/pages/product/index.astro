---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CHEATS_PRIMARY_SLUG } from '../../config/catalog';
import { getProductPage } from '../../data/products';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, productSchema } from '../../utils/schema';
import ProductDetail from '../../components/ProductDetail.astro';
import { useLocale } from '../../i18n';
import { HWID_SPOOFER_PATH, PRODUCT_BASE } from '../../config/site';
import { GALLERY_IMAGE_SIZES, GALLERY_IMAGE_WIDTHS, responsiveSrcSet, webpSrc } from '../../utils/responsiveImage';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const product = getProductPage(CHEATS_PRIMARY_SLUG, locale);

if (!product) {
  return Astro.redirect(lp('/'));
}

const pagePath = PRODUCT_BASE;
const breadcrumbs = [
  { name: t.common.breadcrumbHome, path: '/' },
  { name: t.common.breadcrumbProducts, path: pagePath },
];
const seo = resolvePageSeo(pagePath, locale);
const hwidNav = t.nav.find((item) => item.id === 'hwidSpoofer');
const lcpSlide = product.images[0];
/** Preload the 640w candidate most phones select; srcset still lists 400/640/960. */
const lcpImage = lcpSlide ? webpSrc(lcpSlide.src, 640) : '';
const lcpSrcSet = lcpSlide ? responsiveSrcSet(lcpSlide.src, GALLERY_IMAGE_WIDTHS) : '';
const lcpSizes = GALLERY_IMAGE_SIZES;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    productSchema({
      name: product.title,
      description: product.desc,
      url: lp(pagePath),
      offerUrl: product.buyUrl,
      image: product.images[0]?.src,
      sku: product.slug,
      locale,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  {
    lcpImage && (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={lcpImage}
        imagesrcset={lcpSrcSet}
        imagesizes={lcpSizes}
        type="image/webp"
        fetchpriority="high"
      />
    )
  }
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />

  <section class="border-t border-border pb-12 pt-6">
    <div class="mx-auto max-w-6xl px-5">
      <a href={lp(HWID_SPOOFER_PATH)} class="text-sm font-medium text-primary hover:underline">
        {hwidNav?.label ?? t.pages.utilities.title}
      </a>
    </div>
  </section>
</BaseLayout>
